---
import TrendChart from './TrendChart';
import { formatNumber, formatPct, type DailyReport } from '../lib/reports';

interface Props { report: DailyReport; showArchiveLink?: boolean; }
const { report, showArchiveLink = true } = Astro.props;
const { metadata, marketPulse, nasdaqRegime, movers } = report;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectorMap = new Map<string, { sector: string; weight: number; weightedChange: number; count: number }>();
for (const item of report.sectorHeatmap) {
  const current = sectorMap.get(item.sector) ?? { sector: item.sector, weight: 0, weightedChange: 0, count: 0 };
  current.weight += item.dollarVolume;
  current.weightedChange += item.changePct * item.dollarVolume;
  current.count += 1;
  sectorMap.set(item.sector, current);
}
const sectorSummary = [...sectorMap.values()]
  .map((item) => ({ ...item, changePct: item.weight ? item.weightedChange / item.weight : 0 }))
  .sort((a, b) => b.weight - a.weight);
const maxSectorWeight = Math.max(...sectorSummary.map((item) => item.weight));
const supportLabels = { market: '시장', sector: '업종', catalyst: '특징주' } as const;
const confirmedDeepDives = report.deepDives.filter((item) => item.claimIds.length > 0);
const unknownDeepDives = report.deepDives.filter((item) => item.claimIds.length === 0);
const orderedDeepDives = [...confirmedDeepDives, ...unknownDeepDives];
const heatColor = (change: number) => {
  const strength = Math.min(Math.abs(change) / 5, 1);
  return change >= 0
    ? `rgba(34, ${Math.round(112 + strength * 75)}, ${Math.round(77 + strength * 42)}, ${0.42 + strength * 0.45})`
    : `rgba(${Math.round(128 + strength * 105)}, ${Math.round(57 - strength * 18)}, ${Math.round(64 - strength * 10)}, ${0.46 + strength * 0.45})`;
};
---

<header class="site-header shell">
  <a class="brand" href={`${base}/`}><img class="brand-logo" src={`${base}/favicon.png`} width="34" height="34" alt="" />마켓 렌즈</a>
  <nav class="top-nav" aria-label="주요 메뉴">
    {showArchiveLink && <a href={`${base}/reports/`}>지난 리포트</a>}
    <a href={`${base}/wiki/`}>지식 위키</a>
    <span>{metadata.marketDate}</span>
  </nav>
</header>

<main id="main-content" class="shell">
  {metadata.isDemo && <aside class="demo-banner"><strong>데모 리포트</strong> 실제 Alpaca·뉴스 데이터가 연결되면 자동 생성 리포트로 교체됩니다.</aside>}
  <section class="report-hero narrative-hero">
    <div><p class="eyebrow">Daily market brief · {metadata.marketDate}</p><h1>{report.leadStory.headline}</h1><p class="lead-takeaway">{report.leadStory.takeaway}</p></div>
    <div class="regime-panel"><span>Nasdaq 단기 국면</span><strong>{nasdaqRegime.current}</strong><small>{nasdaqRegime.previous} → {nasdaqRegime.current}</small></div>
  </section>

  <section class="summary-strip story-support" aria-label="오늘의 결론을 뒷받침하는 세 가지 근거">
    {report.leadStory.supportingPoints.map((point, index) => <article><div><span>0{index + 1}</span><b>{supportLabels[point.role]}</b></div><p>{point.text}</p>{point.claimIds.length > 0 && <small>등록 근거 {point.claimIds.length}개</small>}</article>)}
  </section>

  <section class="section market-map" aria-labelledby="pulse-title">
    <div class="section-head"><div><p class="section-kicker">Market map</p><h2 id="pulse-title">오늘 시장의 구조</h2></div><p class="section-note">전 거래일 정규장 종가 대비</p></div>
    <div class="pulse-grid">{marketPulse.map((market) => <article class="market-card"><div class="market-label"><strong>{market.ticker}</strong><span>{market.name}</span></div><p>{market.tracks}</p><div class="market-price"><div class="value">${formatNumber(market.close)}</div><div class:list={['change', market.changePct >= 0 ? 'up' : 'down']}>{formatPct(market.changePct)}</div></div><small>{market.role}</small></article>)}</div>
    <div class="regime-copy"><strong>{nasdaqRegime.previous === '이전 기록 없음' ? `첫 기록: ${nasdaqRegime.current}` : `${nasdaqRegime.previous}에서 ${nasdaqRegime.current}로`}</strong><p>{nasdaqRegime.explanation}</p></div>
    <div class="market-map-heat" aria-labelledby="heat-title">
      <div class="section-head compact"><div><p class="section-kicker">S&P 500 heatmap</p><h3 id="heat-title">업종까지 펼쳐 보면</h3></div><p class="section-note">크기: 거래대금 · 색상: 가중 등락률</p></div>
      <p class="heatmap-guide">큰 타일부터 보세요. 초록은 상승 종목에, 빨강은 하락 종목에 거래대금이 더 실렸다는 뜻입니다.</p>
      <div class="live-heatmap" role="list" aria-label="거래대금 가중 섹터 히트맵">
        {sectorSummary.map((item) => <div class="live-heat" role="listitem" style={`flex-grow:${Math.max(item.weight / maxSectorWeight * 9, 1)};background:${heatColor(item.changePct)}`}><small>{item.count}개 종목</small><strong>{item.sector}</strong><span>{formatPct(item.changePct)}</span></div>)}
      </div>
      <p class="heatmap-footnote">전체 {report.sectorHeatmap.length}개 종목을 섹터 단위로 묶었습니다.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="theme-title">
    <div class="section-head"><div><p class="section-kicker">Evidence-backed themes</p><h2 id="theme-title">오늘 가격을 설명하는 근거</h2></div><p class="section-note">근거가 있을 때만 최대 3개</p></div>
    <div class="theme-grid">{report.themes.map((theme, index) => <article class="theme-card"><span>0{index + 1}</span><h3>{theme.title}</h3><p>{theme.summary}</p><div>{theme.symbols.map((symbol) => <b>{symbol}</b>)}</div></article>)}</div>
  </section>

  <section class="section" aria-labelledby="movers-title">
    <div class="section-head"><div><p class="section-kicker">Top movers</p><h2 id="movers-title">상승 10 · 하락 10</h2></div><p class="section-note">★ 표시는 심층 조사 대상</p></div>
    <div class="movers mover-tables">
      {[{ title: '상승 특징주', rows: movers.gainers, tone: 'up' }, { title: '하락 특징주', rows: movers.losers, tone: 'down' }].map((group) => <article class="mover-panel"><h3 class={group.tone}>{group.title}</h3><div class="table-head"><span>종목</span><span>거래량</span><span>등락률</span></div>{group.rows.map((row) => <div class="mover-row"><div><strong>{row.symbol}{row.deepDive ? ' ★' : ''}</strong><span>{row.name} · {row.sector}</span></div><span>{row.volumeRatio.toFixed(2)}배</span><b class={group.tone}>{formatPct(row.changePct)}</b></div>)}</article>)}
    </div>
  </section>

  <section class="section deep-overview" aria-labelledby="deep-overview-title">
    <div class="section-head"><div><p class="section-kicker">Deep-dive map</p><h2 id="deep-overview-title">심층 6종목, 먼저 분류해서 보기</h2></div><p class="section-note">촉매 확인 여부는 확신의 차이입니다</p></div>
    <div class="deep-overview-grid">
      <article><span>등록 근거와 연결</span><strong>{confirmedDeepDives.length}개</strong><p>{confirmedDeepDives.map((item) => item.symbol).join(' · ') || '없음'}</p><small>아래 설명은 EvidenceLedger의 claimId와 연결됩니다.</small></article>
      <article class="unknown"><span>확인된 단일 촉매 없음</span><strong>{unknownDeepDives.length}개</strong><p>{unknownDeepDives.map((item) => item.symbol).join(' · ') || '없음'}</p><small>추정으로 원인을 채우지 않고 가격·차트 관찰만 남겼습니다.</small></article>
    </div>
  </section>

  <section class="section" aria-labelledby="deep-title">
    <div class="section-head"><div><p class="section-kicker">Evidence-backed notes</p><h2 id="deep-title">핵심 6종목 깊게 보기</h2></div><p class="section-note">확인된 근거 종목부터 배치</p></div>
    <details class="education-details"><summary>차트에서 1개월선·2개월선 읽는 법</summary><p>1개월선은 최근 20거래일, 2개월선은 최근 40거래일 종가 평균입니다. 종가의 위치뿐 아니라 선의 기울기와 거리도 함께 봅니다.</p><a href={`${base}/wiki/concepts/methodology/moving-averages/`}>계산 방법 자세히 보기 →</a></details>
    <div class="deep-grid">
      {orderedDeepDives.map((item) => <article class="deep-card"><div class="deep-card-head"><span class="symbol-chip">{item.symbol}</span><span class="evidence-chip">{item.claimIds.length ? `등록 근거 ${item.claimIds.length}개` : '확인된 단일 촉매 없음'}</span></div><h3>{item.headline}</h3><p>{item.explanation}</p><TrendChart points={item.chart} symbol={item.symbol} client:visible /><div class="reading"><strong>차트 읽기</strong><p>{item.chartReading}</p></div><div class="risk"><strong>확인할 위험</strong><p>{item.risk}</p></div></article>)}
    </div>
  </section>

  <section class="section watch-section" aria-labelledby="watch-title">
    <div class="section-head"><div><p class="section-kicker">Next verification</p><h2 id="watch-title">다음 거래일에 확인할 것</h2></div><p class="section-note">예측이 아닌 후속 확인 목록</p></div>
    <div class="watch-grid">{report.nextWatch.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p><div>{item.symbols.map((symbol) => <b>{symbol}</b>)}</div>{item.claimIds.length > 0 && <small>등록 근거 {item.claimIds.length}개에서 이어짐</small>}</article>)}</div>
  </section>

  <section class="section source-section" aria-labelledby="source-title">
    <div class="section-head"><div><p class="section-kicker">Sources & QA</p><h2 id="source-title">근거와 검수 상태</h2></div><p class="section-note">{metadata.dataSource}</p></div>
    <div class="qa-row">{report.qa.reviews.map((review) => <span><i aria-hidden="true"></i>{review.reviewer.replaceAll('_', ' ')} · {review.verdict}</span>)}</div>
    <details class="source-details"><summary>검증에 사용한 출처 {report.sources.length}개 보기</summary><ol class="source-list">{report.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.publisher}</strong> · {source.title}</a><time>{source.publishedAt.slice(0, 10)}</time></li>)}</ol></details>
  </section>

  <details class="report-appendix">
    <summary><div><span>Beginner appendix</span><strong>ETF·배당주 관찰 표본</strong><small>일일 시장 이야기와 분리해 필요할 때만 펼쳐봅니다.</small></div><b>펼쳐보기 ＋</b></summary>
    <div class="appendix-body"><h3>ETF·ETP</h3><div class="basket-grid">{report.incomeBasket.filter((item) => item.kind === 'ETF').map((item) => <article><div><span>{item.kind}</span><strong>{item.symbol}</strong><em class={item.changePct >= 0 ? 'up' : 'down'}>{formatPct(item.changePct)}</em></div><h3>{item.name}</h3><p>{item.description}</p></article>)}</div><h3>개별 배당주 표본</h3><div class="basket-grid">{report.incomeBasket.filter((item) => item.kind === '주식').map((item) => <article><div><span>{item.kind}</span><strong>{item.symbol}</strong><em class={item.changePct >= 0 ? 'up' : 'down'}>{formatPct(item.changePct)}</em></div><h3>{item.name}</h3><p>{item.description}</p></article>)}</div><a class="appendix-wiki-link" href={`${base}/wiki/`}>QQQ·QQQM·SPY 차이와 금융 용어는 지식 위키에서 보기 →</a></div>
  </details>

  {showArchiveLink && <div class="archive-cta"><a href={`${base}/reports/`}>지난 리포트 모두 보기 <span>→</span></a><a href={`${base}/wiki/`}>종목·테마 지식 위키 <span>→</span></a></div>}
</main>

<footer class="footer"><div class="shell"><strong>마켓 렌즈</strong><span>교육 목적의 시장 정보이며 투자 권유가 아닙니다. 모든 투자 판단과 책임은 이용자에게 있습니다.</span></div></footer>
