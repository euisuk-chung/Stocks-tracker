---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportView from '../../components/ReportView.astro';
import { reports, type DailyReport } from '../../lib/reports';

export function getStaticPaths() {
  return reports.map((report) => ({ params: { date: report.metadata.marketDate }, props: { report } }));
}

interface Props { report: DailyReport; }
const { report } = Astro.props;
---
<BaseLayout title={`${report.metadata.marketDate} 미국시장 리포트 | 마켓 렌즈`} description={report.summary[0]}>
  <ReportView report={report} showArchiveLink={true} />
</BaseLayout>
