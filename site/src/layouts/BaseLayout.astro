---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '마켓 렌즈',
  description = '미국 시장의 움직임을 초보자 눈높이로 정리하는 일일 리포트',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://euisuk-chung.github.io/Stocks-tracker/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://euisuk-chung.github.io/Stocks-tracker/og.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문 바로가기</a>
    <slot />
  </body>
</html>
